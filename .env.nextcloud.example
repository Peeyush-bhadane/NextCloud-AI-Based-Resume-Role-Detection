# ==============================================================================
# Nextcloud & MariaDB Cloud Infrastructure Configuration
# ==============================================================================

# MariaDB Database Credentials
MYSQL_ROOT_PASSWORD=NextcloudRoot2026!
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud_user
MYSQL_PASSWORD=NextcloudUserPass2026!

# Nextcloud Web Port (Accessible in browser at http://localhost:8080)
NEXTCLOUD_PORT=8080

# Nextcloud Initial Admin Account
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=AdminSecurePassword2026!

# Allowed Hostnames / IPs for Nextcloud (space-separated)
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 192.168.1.100

# AI Resume Analyzer Port (Accessible in browser at http://localhost:8501)
STREAMLIT_PORT=8501
